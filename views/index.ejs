<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
</head>
<body class="page" style="background-color: white";>

<!-- navigation -->
<!-- <%- include("../partials/navbar.ejs") %> -->

<!-- error flashing -->
<!-- <%- include ("../partials/flashing.ejs") %> -->

<% if (!loggedIn) { %>

<div class="container">

    <div class="image-section">
        <img src="/data/serve.png" width="200px" alt="pixel art image of an isometric home">
    </div>

    <div class="text-section">
        <h1 class="start-logo">serve</h1>

        <h1><a class="start-btn" href="/login/">login</a></h1>
        <h1><a class="start-btn" href="/signup/">create an account</a></h1>
    </div>

</div>

<!-- shows link to saved recipes if logged in -->

<% } 
else { %>
    <p><a href="/saved" class="nav-btn">saved recipes</a></p>

<% } %>

<!-- load local js -->
<script src="/main.js"></script>
</body>
</html>