<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>
<body class="recipe" >

<h1>SERVE</h1>

<!-- FOOD IMAGES AT THIS PATH: data/food-ingredients-and-recipe-dataset-with-images/versions/1/food-images/Food\ Images/ -->

<!-- ADD NAV BAR -->

<!-- ADD SEARCH BAR  -->
<div class="search-container">
        <form method="get" action="/recipes/"> 
            <input type="search" 
            id="recipe-search" 
            name="searchInput" 
            placeholder="search for a recipe..." 
            style="color: white; font-size: 20px; padding: 5px;" />
            <button class="filter-btn">filter</button>
        </form>
</div>


<!-- ADD FILTER OPTIONS -->
<!-- <span id="filter">
    <button>filter</button>
</span> -->

<div class="card-container">
    <% recipes.slice(0,12).forEach( (recipe) => {  %>
        <span class="recipeCard">
            <h1 class="recipe-text"> <%= recipe.title %> </h1>
            <!-- <p class="recipe-text"><%= recipe.imageName %> </p> -->
             <img src = "/data/recipe-images/recipe-imgfiles/<%= recipe.imageName %>.jpg" alt="Image of <%= recipe.title %>">
            <!-- <p class="recipe-text"> <%= recipe.ingredients %> </p> -->
            <p><strong>Ingredients:</strong></p style="font-size: 20px;">
            <ul class="recipe-text"> <% recipe.cleanedIngredients.forEach(ingredient =>{ %>
                <li><%= ingredient %></li>
            <% }) %> 
            </ul>
        </span>
        
    <% }) %>
</div>

    <!-- load local js -->
    <script src="/main.js"></script>
</body>
</html>