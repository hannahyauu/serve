<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>
<body class="recipe">
    
<!-- navigation -->
<%- include("../partials/navbar.ejs") %>

<!-- error flashing -->
<%- include ("../partials/flashing.ejs") %>


<!-- FOOD IMAGES AT THIS PATH: data/food-ingredients-and-recipe-dataset-with-images/versions/1/food-images/Food\ Images/ -->

<!-- search bar and add recipe button -->
<div class="search-container">
    <form method="get" action="/recipes/">
        <input type="search" 
        id="recipe-search" 
        name="searchInput" 
        placeholder="search for a recipe..." 
        style="color: white; font-size: 20px; padding: 5px;" />
    <button type="button" id="filter-toggle">filter</button>

        <div id="filter-menu" class="filter-menu hidden">
            <label>
                <input type="checkbox" name="filters" value="currInventory">
                With ingredients in inventory
            </label>
            <label>
                <input type="checkbox" name="filters" value="vegan">
                Vegan
            </label>

            <label>
                <input type="checkbox" name="filters" value="vegetarian">
                Vegetarian
            </label>

            <label>
                <input type="checkbox" name="filters" value="glutenFree">
                Gluten-free
            </label>

            <label>
                <input type="checkbox" name="filters" value="halal">
                Halal
            </label>

            <button type="submit">Apply</button>
        </div>
    </form>

    <button id="add-recipe" class="recipe-button">new recipe</button>
</div>

<!-- add recipe form -->
<div class="overlay" id="overlay" style="display:none;">
    <div class="form-popup" id="recipe-popup" style="display:none;">
        <form id="new-recipe" method="POST" action="/add-recipe" enctype="multipart/form-data">
            <h1>enter recipe</h1>
            <label>recipe name
                <input type="text" name="recipeName" placeholder="recipe name" required>
            </label>
            <label>image
                <input type="file" name="image" accept="image/*">
            </label>
            <label>ingredients (separate with commas)
                <input type="text" name="ingredients" required>
            </label>
            <label>instructions
                <textarea rows="10" cols="32" name="instructions" 
                       placeholder="1. Beat eggs in medium sized bowl..." required></textarea>
            </label>
            <button type="submit">submit</button>
            <button type="button" onclick="closeForm('recipe-popup')">close</button>
        </form>
    </div>
</div>

<div class="card-container">
    <% recipes.slice(0,50).forEach(recipe => { %>

        <div class="recipeCard">
            <a href="/recipes/<%= recipe.recipeID %>" class="recipe-link">

                <div class="recipe-card-content">
                    <h2 class="recipe-title"><%= recipe.title %></h2>
                
                    <% if (recipe.recipeID <= 13500) { %>
                        <img class="recipe-img" src = "/data/recipe-images/recipe-imgfiles/<%= recipe.imageName %>.jpg" alt="Image of <%= recipe.title %>">
                    <% } else { %>
                        <img class="recipe-img" src = "/<%= recipe.imageName %>" alt="Image of <%= recipe.title %>">
                    <% } %>
                    
                    <p class="ingredient-preview">
                        <% recipe.cleanedIngredients.slice(0,4).forEach(ingredient => { %>
                            <span><%= ingredient %></span>
                        <% }) %>
                    </p>

                    <p class="view-more">view recipe →</p>
                </div>
            </a>

            <form action="/save-recipe" method="POST" class="heart-form">
                <input type="hidden" name="recipeID" value="<%= recipe.recipeID %>">
                <button 
                    type="button" 
                    class="heart-btn <%= (savedRecipes || []).includes(recipe.recipeID) ? 'likedHeart' : 'unlikedHeart' %>"
                    data-recipe-id="<%= recipe.recipeID %>"
                >
                    ♥
                </button>
            </form>
        </div>

    <% }) %>
</div>

<script>

$(".heart-btn").on("click", function () {

    const button = $(this);
    console.log(button);
    const recipeID = button.data("recipe-id");

    $.post("/save-recipe/" + recipeID).then(function (resp) {

        if (resp.error) {
            alert(resp.error);
            return;
        }

        if (resp.saved) {
            button.removeClass("unlikedHeart");
            button.addClass("likedHeart");
        } else {
            button.removeClass("likedHeart");
            button.addClass("unlikedHeart");
        }
    });
});

// turn display on for popup and blur overlay
    function openForm(id) { 
        document.getElementById(id).style.display = "block";
        document.getElementById("overlay").style.display = "block";;
    };

// turn display off for popup and blur overlay
function closeForm(id) { 
    document.getElementById(id).style.display = "none";
    document.getElementById("overlay").style.display = "none";
}

// get add recipe button (plus sign)
let addButton = document.getElementById("add-recipe"); 

// open add recipe form if currently closed & vice versa
addButton.addEventListener("click", function () {
    let current = document.getElementById("recipe-popup").style.display;
    if (current == "none") {
        openForm("recipe-popup");
    } else {
        closeForm("recipe-popup");
    }
});

const filterToggle = document.querySelector("#filter-toggle");
const filterMenu = document.querySelector("#filter-menu");

filterToggle.addEventListener("click", () => {
    filterMenu.classList.toggle("hidden");
});

</script>

<!-- load local js -->
<script src="/main.js"></script>
</body>
</html>