<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>
<body class="recipe" >
    
<!-- navigation -->
<%- include("../partials/navbar.ejs") %>

<!-- error flashing -->
<%- include ("../partials/flashing.ejs") %>


<!-- FOOD IMAGES AT THIS PATH: data/food-ingredients-and-recipe-dataset-with-images/versions/1/food-images/Food\ Images/ -->

<!-- search bar -->
<div class="search-container">
    <form method="get" action="/recipes/"> 
        <input type="search" 
        id="recipe-search" 
        name="searchInput" 
        placeholder="search for a recipe..." 
        style="color: white; font-size: 20px; padding: 5px;" />
    <button type="button" id="filter-toggle">filter</button>

        <div id="filter-menu" class="filter-menu hidden">
            <label>
                <input type="checkbox" name="filters" value="vegan">
                Vegan
            </label>

            <label>
                <input type="checkbox" name="filters" value="vegetarian">
                Vegetarian
            </label>

            <label>
                <input type="checkbox" name="filters" value="glutenFree">
                Gluten-free
            </label>

            <label>
                <input type="checkbox" name="filters" value="halal">
                Halal
            </label>

            <button type="submit">Apply</button>
        </div>
    </form>
</div>

<div class="card-container">
    <% recipes.slice(0,50).forEach(recipe => { %>

        <div class="recipeCard">
            <a href="/recipes/<%= recipe.recipeID %>" class="recipe-link">


                <div class="recipe-card-content">
                    <h2 class="recipe-title"><%= recipe.title %></h2>
                
                    <img 
                    class="recipe-img"
                    src="/data/recipe-images/recipe-imgfiles/<%= recipe.imageName %>.jpg" 
                    alt="Image of <%= recipe.title %>">

                    <p class="ingredient-preview">
                        <% recipe.cleanedIngredients.slice(0,4).forEach(ingredient => { %>
                            <span><%= ingredient %></span>
                        <% }) %>
                    </p>

                    <p class="view-more">view recipe →</p>
                </div>
            </a>

            <form action="/save-recipe" method="POST" class="heart-form">
                <input type="hidden" name="recipeID" value="<%= recipe.recipeID %>">
                <button 
                    type="submit" 
                    class="heart-btn <%= (savedRecipes || []).includes(recipe.recipeID) ? 'likedHeart' : 'unlikedHeart' %>"
                >
                    ♥
                </button>
            </form>
        </div>

    <% }) %>
</div>

<script>
// if click on heart button, turn to red for saved, vice versa.
document.querySelectorAll('.unlikedHeart').forEach(button => {
    button.addEventListener('click', function () {
        this.classList.toggle('likedHeart');
    });

});


const filterToggle = document.querySelector("#filter-toggle");
const filterMenu = document.querySelector("#filter-menu");

filterToggle.addEventListener("click", () => {
    filterMenu.classList.toggle("hidden");
});

</script>

<!-- load local js -->
<script src="/main.js"></script>
</body>
</html>