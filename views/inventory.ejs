<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>

<body class="page">

<!-- navigation -->
<%- include("../partials/navbar.ejs") %>

<!-- error flashing -->
<!-- <%- include ("../partials/flashing.ejs") %> -->

<% if (expiringItems && expiringItems.length > 0) { %>
    <details class="expiration-flash">
        <summary>
            <strong><%= expiringItems.length %></strong> of your ingredients are close to expiring!
        </summary>

        <ul>
            <% expiringItems.forEach(item => { %>
                <li><%= item %></li>
            <% }) %>
        </ul>
    </details>
<% } %>

<!-- location select -->

<div class="button-bar">
    <div class="button-links">
        <a href="/inventory/fridge" class="nav-btn">fridge</a>
        <a href="/inventory/freezer" class="nav-btn">freezer</a>
        <a href="/inventory/pantry" class="nav-btn">pantry</a>
    </div>
</div>

<!-- render list of current ingredients in users inventory -->
<div class="shelf">
    <% if (ingredients && ingredients.length > 0) { %>
        <% ingredients.forEach( (ingredient) => { %>
            <% if (ingredient.location === location) { %>
                <span class="ingredient-container">
                    <img src="/data/ingredient-images/<%= ingredient.validImgFile %>" 
                    alt="Image of <%= ingredient.itemName %>">
                    <h2><%= ingredient.itemName %></h2>
                    <p><b>expires:</b> <%= ingredient.expiration %></p>
                    
                    <form action="/delete-item" method="POST">
                        <input type="hidden" name="itemId" value="<%= ingredient.itemName %>">
                        <input type="hidden" name="location" value="<%= ingredient.location %>">
                        <button type="submit" class="delete-btn">delete</button>
                    </form>
                </span>
            <% } %>
        <% }) %>
    <% } %>
    <button id="add-ingredient" class="add-button">+</button>
</div>

<!-- form for adding an ingredient into inventory. takes name, location, expiration -->
<div class="overlay" id="overlay" style="display:none;">
    <div class="form-popup" id="item-popup" style="display:none;">
        <form id="ingredient-form" action="/add-item" method="POST">
            <h1>enter item</h1>
            <label>item name
                <input type="text" name="itemName" placeholder="item name" required>
            </label>
            <label>storage location
                <select name="chosenLocation" required>
                    <% locations.forEach( (location) => { %>
                        <option value="<%= location %>"><%= location %></option>
                    <% }) %>
                </select>
            </label>
            <label>expiration date
                <input type="date" name="expiration" placeholder="expiration date">
            </label>
            <button type="submit">submit</button>
            <button type="button" onclick="closeForm('item-popup')">close</button>
        </form>
    </div>
</div>

<!-- load local js -->
<script src="/main.js"></script>

<script>
    // turn display on for popup and blur overlay
    function openForm(id) { 
        document.getElementById(id).style.display = "block";
        document.getElementById("overlay").style.display = "block";;
    };

    // turn display off for popup and blur overlay
    function closeForm(id) { 
        document.getElementById(id).style.display = "none";
        document.getElementById("overlay").style.display = "none";
    }
    
    // get add ingredient button (large plus sign)
    let element = document.getElementById("add-ingredient");
    
    // open form if currently closed & vice versa
    element.addEventListener("click", function () {
        let current = document.getElementById("item-popup").style.display;
        console.log(current);
        if (current == "none") {
            openForm("item-popup");
        } else {
            closeForm("item-popup");
        }
    });
</script>
</body>
</html>