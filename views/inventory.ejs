<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>

<body class="page">

<!-- navigation -->
<%- include("../partials/navbar.ejs") %>

<!-- error flashing -->
<%- include ("../partials/flashing.ejs") %>

<!-- location select -->
<form method="GET">
    <p><label>
        <select required name="location">
            <% locations.forEach( (location, index) => { %>
            <option value="<%= index %>"><%= location %></option>
            <% }) %>
        </select>
    </label></p>
</form>

<!-- list of current ingredients -->
<div class="shelf">
    <% ingredients.forEach( (ingredient) => { %>
    <span class="ingredient-container">
        <img src = "/data/ingredient-images/<%= ingredient.imgFile %>" alt="Image of <%= ingredient.name %>" style="width: 50px">
        <h2><%= ingredient.name %></h2>
        <p><%= ingredient.image %></p>
        <p><b>expires:</b> <%= ingredient.expiration %></p>
        <p><b>amount:</b> <%= ingredient.amount %></p>
    </span>
    <% }) %>   
    
    <button id="add-ingredient" class="add-button">+</button>
    <div class="form-popup" id="item-popup" style="display:none; position:fixed;">
        <form id="ingredient-form" action="/add-item" method="POST">
            <h1>enter item</h1>
            <label>item name
                <input type="text" name="item-name" placeholder="item name" required>
            </label>
            <label>image file (not functional yet)
                <input type="text" name="imgFile" placeholder="image">
            </label>
            <label>expiration date
                <input type="text" name="expiration" placeholder="expiration date">
            </label>
            <label>amount
                <input type="text" name="amount" placeholder=1>
            </label>
            <button type="submit">submit</button>
            <button type="button" onclick="closeForm()">close</button>
        </form>
    </div>
</div>

<!-- load local js -->
<script src="/main.js"></script>

<script>
    // open/close ingredient form popup
    function openForm() { 
        let element = document.getElementById("item-popup");
        element.style.display = "block";
        element.style.backdropFilter = "grayscale(100%) blur(10px)";
    };

    function closeForm() { 
        let element = document.getElementById("item-popup");
        element.style.display = "none";
    }
    
    let element = document.getElementById("add-ingredient");
    
    // open form if currently closed & vice versa
    element.addEventListener("click", function () {
        let current = document.getElementById("item-popup").style.display;
        console.log(current);
        if (current == "none") {
            openForm();
        } else {
            closeForm();
        }
    });
</script>

</body>
</html>