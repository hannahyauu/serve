<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css">
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>

<body class="page">

<!-- navigation -->
<%- include("../partials/navbar.ejs") %>

<!-- error flashing -->
<%- include ("../partials/flashing.ejs") %>

<!-- edit recipe form -->
<div>
    <form id="edit-recipe" method="POST" action="/update-recipe/<%= recipeID %>" enctype="multipart/form-data">
        <h1>edit recipe</h1>
        <label>recipe name
            <input type="text" name="recipeName" value="<%= recipe.title %>">
        </label>
        <label>image
            <input type="file" name="image" accept="image/*">
            <input type="hidden" name="existingImage" value="<%= recipe.imageName %>">
        </label>
        <label>ingredients (separate with commas)
            <input type="text" name="ingredients" value="<%= recipe.ingredients %>">
        </label>
        <label>instructions
            <textarea rows="10" cols="32" name="instructions"><%= recipe.instructions %></textarea>
        </label>
        <button type="submit">save changes</button>
    </form>
    
    <!-- delete recipe button -->
    <form id="delete-recipe" method="POST" action="/delete-recipe/<%= recipe.recipeID %>">
        <button type="submit" onclick="return confirm('Are you sure you want to delete this recipe?')">
            delete recipe
        </button>
    </form>
</div>

</body>
</html>