<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>serve</title>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    <!-- loading jquery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>

<body class="page">

<!-- navigation -->
<%- include("../partials/navbar.ejs") %>

<!-- error flashing -->
<%- include ("../partials/flashing.ejs") %>

<!-- render recipe title, ingredients, and complete instructions -->
<div class="recipe-text" style = "color: #11153f; text-shadow: 15em;">
    <h1><%= recipe.title %></h1>
        <% if (recipe.recipeID <= 13500) { %>
            <img src = "/data/recipe-images/recipe-imgfiles/<%= recipe.imageName %>.jpg" alt="Image of <%= recipe.title %>">
        <% } else { %>
            <img src = "/<%= recipe.imageName %>" alt="Image of <%= recipe.title %>">
        <% } %>
    <p><strong>Ingredients:</strong></p style="font-size: 20px;">
    <ul> <% recipe.cleanedIngredients.forEach(ingredient =>{ %>
        <li><%= ingredient %></li>
        <% }) %> 
    </ul>
    <p> <%= recipe.instructions %> </p>
</div>

</body>
</html>